# ETF money-flow scheduler: leave the explicit watchlist empty to use the dynamic universe.
# The default tracks all ETFs whose current total market cap is at least 100亿元.
VNTDR_ETF_WATCHLIST=
# 100亿元 = 10000000000元
VNTDR_ETF_MIN_MARKET_CAP=10000000000
VNTDR_ETF_MAX_UNIVERSE_SIZE=

GRADIO_PORT=7860
GRADIO_CONTAINER_PORT=7860
